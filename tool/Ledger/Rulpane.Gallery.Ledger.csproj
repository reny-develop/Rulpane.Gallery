<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ledger and the copies beside it, read and written, and a release read and run with
    Rulpane's own code: by the tool that admits a release and by the one that renders the pages.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RulpaneRoot)src/Rulpane.Engine/Rulpane.Engine.csproj" />
    <!-- Where the bundled documents are, for a sample that names one. -->
    <AssemblyMetadata Include="RulpaneRoot" Value="$([System.IO.Path]::GetFullPath('$(RulpaneRoot)'))" />
  </ItemGroup>

</Project>
