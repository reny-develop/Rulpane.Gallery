{
  "$schema": "rulealize/view/v1",
  "ruleSet": "Rulealize.RuleSet.Scoreboard@1",
  "title": "点数表",
  "layout": [
    {
      "c": "table",
      "title": "順位",
      "bind": "standings",
      "columns": [
        {
          "key": "leading",
          "label": ""
        },
        {
          "key": "player",
          "label": "プレイヤー"
        },
        {
          "key": "rounds",
          "label": "回数"
        },
        {
          "key": "total",
          "label": "合計"
        }
      ],
      "rowActions": [
        {
          "input": "score",
          "args": {
            "player": "player"
          }
        },
        {
          "input": "rename",
          "args": {
            "name": "player"
          }
        },
        {
          "input": "leave",
          "args": {
            "name": "player"
          }
        }
      ]
    },
    {
      "c": "columns",
      "blocks": [
        {
          "c": "actions",
          "title": "プレイヤーを足す",
          "inputs": [
            "join"
          ]
        },
        {
          "c": "actions",
          "title": "入れ間違えたら",
          "inputs": [
            "undo"
          ]
        },
        {
          "c": "actions",
          "title": "全部消して始める",
          "inputs": [
            "clear"
          ]
        }
      ]
    }
  ],
  "names": {
    "inputs": {
      "score": "入れる",
      "join": "足す",
      "undo": "最後の点を取り消す",
      "leave": "外す",
      "clear": "プレイヤーと点を全部消す",
      "rename": "変える"
    },
    "params": {
      "player": "プレイヤー",
      "points": "点",
      "name": "名前",
      "to": "新しい名前"
    },
    "codes": {
      "name.taken": "その名前の人はもういます。"
    }
  }
}
